# OS / editor junk
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Secrets and local credentials
.env
.env.*
*.pem
*.key
credentials.json
**/secrets/**

# Cmder runtime (never commit histories/logs)
**/clink_history*
**/clink.log
**/clink_errorlevel*

# Large installers / downloads
*.exe
*.msi
*.zip
downloads/

# Local scratch
*.backup
*.bak
.local/

# Lavish review sessions (scratch; committed smoke pages live under agent/skills/lavish/)
.lavish/

# Optional personal skill junctions (content lives only in private dev-hub-personal).
# Git on Windows follows junctions, so each linked folder must be excluded - but the
# names are personal, so Agent apply writes them to .git/info/exclude (untracked)
# instead of this file. See machine/link.ps1 -> Update-PersonalSkillExcludes.
